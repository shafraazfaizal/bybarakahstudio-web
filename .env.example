# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

NEXT_PUBLIC_SITE_URL=https://barakah.skayl.digital

# Supabase (Project Settings → API). The service role key is SERVER ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (optional — signups still save without it)
RESEND_API_KEY=
WAITLIST_FROM_EMAIL="ByBarakahStudio <barakah@skayl.digital>"
WAITLIST_REPLY_TO=
# Where "new signup" alerts go
WAITLIST_NOTIFY_EMAIL=bybarakahstudio@gmail.com
